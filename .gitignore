# Python caches & build artifacts
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.env/
.pytest_cache/
.ipynb_checkpoints/

# OS & IDE
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*.swo

# Candidate workspaces: heavy or generated research artifacts stay local.
# Identity records, protocols, decisions, and code remain tracked.
# Legacy frozen projects honor their own ignore rules inside
# candidate/<id>/legacy-project/.
candidate/*/data/raw/*
candidate/*/data/external/*
candidate/*/data/interim/*
candidate/*/data/processed/*
candidate/*/outputs/*
candidate/*/figures/*
candidate/*/scratch/*
candidate/*/literature/fulltext/*
candidate/*/releases/*/build/**
candidate/*/.cache/*
!candidate/**/.gitkeep
EXONYM_FACTORY_PLAN.txt
